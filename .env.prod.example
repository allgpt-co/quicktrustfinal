# Production environment template. Copy to .env.prod and replace every placeholder.

# PostgreSQL
POSTGRES_USER=quicktrust
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=quicktrust
DATABASE_URL=postgresql+asyncpg://quicktrust:replace-with-strong-postgres-password@postgres:5432/quicktrust

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0

# Keycloak
KEYCLOAK_URL=https://keycloak.quicktrustapp.com
KEYCLOAK_REALM=quicktrust
KEYCLOAK_CLIENT_ID=quicktrust-api
KEYCLOAK_CLIENT_SECRET=replace-with-generated-keycloak-client-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-keycloak-admin-password
KC_HOSTNAME=keycloak.quicktrustapp.com

# Amazon S3 Object Storage
AWS_ACCESS_KEY_ID=replace-with-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-iam-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_BUCKET=replace-with-production-evidence-bucket
S3_REPORTS_BUCKET=replace-with-production-reports-bucket
S3_FORCE_PATH_STYLE=false
S3_CREATE_BUCKET=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# LiteLLM / AI
LITELLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@example.com
SMTP_USE_TLS=true

# Frontend
NEXT_PUBLIC_API_URL=https://api.quicktrustapp.com
NEXT_PUBLIC_APP_URL=https://quicktrustapp.com
NEXT_PUBLIC_KEYCLOAK_URL=https://keycloak.quicktrustapp.com
NEXT_PUBLIC_KEYCLOAK_REALM=quicktrust
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=quicktrust-web

# App
APP_NAME=QuickTrust
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-random-32-byte-secret
CORS_ORIGINS=https://quicktrustapp.com
