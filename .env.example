# PostgreSQL
POSTGRES_USER=quicktrust
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=quicktrust
DATABASE_URL=postgresql+asyncpg://quicktrust:replace-with-strong-postgres-password@postgres:5432/quicktrust

# Redis
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0


# Object Storage (S3-compatible local development)
AWS_ACCESS_KEY_ID=replace-with-local-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-local-s3-secret-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=quicktrust-evidence
S3_REPORTS_BUCKET=quicktrust-reports
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# Amazon Bedrock / AI
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=
BEDROCK_INPUT_COST_PER_MILLION=0
BEDROCK_OUTPUT_COST_PER_MILLION=0

# SMTP Email (optional — notifications fall back to logging when not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@quicktrust.dev
SMTP_USE_TLS=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# App
APP_NAME=QuickTrust
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-random-32-byte-secret

# Application-managed authentication
JWT_ISSUER=quicktrust
JWT_AUDIENCE=quicktrust-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000
