{
  "name": "quicktrust",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, agent-first GRC platform — fast, affordable compliance automation",
  "scripts": {
    "dev": "docker compose up",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "docker compose up api",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "seed": "docker compose exec api python -m seeds.run_seeds"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "sharp": "0.35.0",
      "postcss": "8.5.12"
    }
  }
}
